{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "simple-mailbox",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [{ "pattern": "bmail.beenex.company", "custom_domain": true }],

  // The React app is static assets. API calls always reach the Worker first.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Daily: drop expired sessions and stale sign-in failures.
  "triggers": { "crons": ["17 4 * * *"] },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "simple-mailbox-db",
      // scripts/ensure-d1.mjs checks this during deploy and creates the database if it is missing.
      "database_id": "7dd1eaa8-781d-421f-a784-9c56f7c35c9f",
      "migrations_dir": "migrations"
    }
  ]
  // Inbound mail: in Cloudflare, for each domain, Email > Email Routing > Catch-all address
  // > Send to a Worker > simple-mailbox. Outbound mail goes through Resend.
}
